{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':configMigration', // https://docs.renovatebot.com/configuration-options/#configmigration
  ],
  packageRules: [
    {
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
