{
  "name": "kompassi2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "concurrently -kn nextdev,codegen \"next dev\" \"graphql-codegen -w\"",
    "format": "prettier --write .",
    "k8s:dev": "npm run k8s:generate && skaffold dev",
    "k8s:generate": "cd kubernetes && tsx manifest.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node .next/standalone/server.js",
    "test": "npm run lint && npm run test:format",
    "test:format": "prettier --check ."
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@con2/components": "github:con2/components#v4.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.1",
    "bootstrap": "^5.3.5",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "prettier": {},
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
